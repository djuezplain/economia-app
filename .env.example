# Despliegue en Raspberry Pi (docker-compose.yml, ver deploy/README.md).
# Copia este fichero a `.env` (en la raíz, junto a docker-compose.yml) y
# rellena los valores. NUNCA subas `.env` a git (ya está en .gitignore).
#
# Distinto de backend/.env.example: aquel es para correr el backend suelto
# en local (`npm run start:dev`); este es para el despliegue con Docker
# Compose de los 3 servicios juntos.

# --- Postgres ---
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-real

# --- Backend ---
# Genera cada secreto con: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Tiene que ser un dominio real (Joi valida el TLD) — .local/.internal no
# pasan la validación aunque el formato del email sea correcto.
MAIL_FROM=no-reply@economia-app.dev

# URL desde la que se sirve el frontend — el backend la necesita para CORS
# y para la cookie del refresh token.
# - Solo LAN (por defecto): IP o hostname de la Pi, sin puerto si usas el 80.
#   Ejemplo: http://192.168.1.50 o http://raspberrypi.local
# - Con Cloudflare Tunnel (deploy/README.md §9): el subdominio https del
#   frontend. Ejemplo: https://app.tudominio.com
FRONTEND_URL=

# Login con Google (opcional). Deja vacíos CLIENT_ID/SECRET si no lo vas a
# usar — el backend ya responde 503 de forma controlada en ese caso.
# GOOGLE_CALLBACK_URL sí necesita una URL con formato válido aunque no se
# use (a diferencia de CLIENT_ID/SECRET, el backend no admite este campo
# vacío) — déjalo con el valor de ejemplo de abajo si no usas Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Importación desde Google Sheets (opcional, spec 026). Deja vacíos si no
# la vas a usar — el backend responde 503 de forma controlada en esos
# endpoints. `client_email`/`private_key` del JSON de la cuenta de
# servicio de Google Cloud (Sheets API habilitada); pega `private_key`
# tal cual, con los `\n` literales — el backend los convierte en saltos
# de línea reales al leerlo.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Frontend ---
# URL del backend. Solo se usa al construir la imagen (`docker compose
# build`/`up --build`) — las variables VITE_* se incrustan en el bundle,
# así que cambiar este valor exige reconstruir la imagen del frontend, no
# basta con reiniciar el contenedor.
# - Solo LAN (por defecto): IP/hostname de la Pi + puerto del backend (3000).
#   Ejemplo: http://192.168.1.50:3000
# - Con Cloudflare Tunnel (deploy/README.md §9): el subdominio https del
#   backend. Ejemplo: https://api.tudominio.com
VITE_API_BASE_URL=

# --- Cloudflare Tunnel (opcional, deploy/README.md §9) ---
# Token del túnel (Zero Trust → Networks → Tunnels → tu túnel → pestaña
# "Install and run a connector" → copia solo el valor de --token). Déjalo
# vacío si solo quieres acceso en LAN.
CLOUDFLARE_TUNNEL_TOKEN=

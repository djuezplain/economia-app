[Unit]
Description=Copia de seguridad de la base de datos de economia-app
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Ajusta usuario y ruta a los tuyos (ver deploy/README.md) — tu usuario ya
# está en el grupo `docker` (paso 2 de la guía), no hace falta root.
User=pi
WorkingDirectory=/home/pi/economia-app
ExecStart=/home/pi/economia-app/deploy/backup.sh

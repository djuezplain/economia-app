# Spec 034 (comparativa de precios desde tickets escaneados): API key de un
# proyecto de Google Cloud con "Cloud Vision API" habilitada, restringida a
# esa API. Sin ella, POST /receipt-import/preview responde 503.
GOOGLE_CLOUD_VISION_API_KEY=""
# Spec 032 H5 (exportación programada): carpeta base donde se escriben las
# exportaciones programadas con destino "carpeta en el servidor" — cada
# usuario tiene su propia subcarpeta dentro de esta. Opcional: por defecto,
# `./scheduled-exports` relativo al directorio de trabajo del backend.
SCHEDULED_EXPORT_LOCAL_DIR="./scheduled-exports"
MAIL_FROM="no-reply@economia-app.dev"
FRONTEND_URL="http://localhost:5173"

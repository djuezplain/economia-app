{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    // "multer" añadido en spec 003 (T2.1): sin él, `@types/multer` no
    // aumenta el namespace global `Express` con `Express.Multer.File`
    // (el `types` explícito de este proyecto ya excluía la inclusión
    // automática de ambient types de "types") y `ImportController` no
    // podría tipar el fichero subido.
    "types": ["vitest/globals", "node", "multer"]
  }
}
